# Copiază acest fișier în ".env" și completează valorile reale.
# NICIODATĂ chei/parole direct în cod (R-504) — doar aici sau ca variabile de mediu.

# --- Email (SMTP) — folosit pentru trimiterea rapoartelor către clienți (secțiunea 10) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Prognoza Producție Energie
SMTP_USE_TLS=true

# --- Bază de date locală ---
# Implicit SQLite local. Când se trece pe server (secțiunea 16), se schimbă DOAR
# aici tipul de storage (vezi app/storage/repository.py) — restul codului nu se atinge.
STORAGE_BACKEND=sqlite
SQLITE_PATH=data/prognoza.db

# --- Firestore (folosit DOAR când STORAGE_BACKEND=firestore, etapa 2 a proiectului) ---
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Furnizor date meteo (Open-Meteo nu cere cheie API) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
# Arhiva de vreme REALĂ reconstruită (ERA5) — folosită DOAR de calibrarea geometriei (secțiunea 7),
# diferită intenționat de arhiva de "rulări precedente" de mai sus, folosită la antrenarea ML (R-610, R-701).
OPEN_METEO_REANALIZA_URL=https://archive-api.open-meteo.com/v1/archive

# --- Fus orar operare (R-903) ---
APP_TIMEZONE=Europe/Bucharest
